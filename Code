<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>FRT 시트 알람 PRO</title>
    <style>
        /* 기본 변수 (라이트 모드) */
        :root {
            --bg: #F2F2F7;
            --card: #FFFFFF;
            --text: #1C1C1E;
            --secondary: #8E8E93;
            --primary: #007AFF; 
            --tab-bg: #E3E3E8;
        }

        /* 다크 모드 (일반) */
        body.dark-mode {
            --bg: #1C1C1E;
            --card: #2C2C2E;
            --text: #FFFFFF;
            --secondary: #AEAEB2;
            --tab-bg: #3A3A3C;
        }

        /* 다크 모드 (OLED) */
        body.oled-mode {
            --bg: #000000;
            --card: #151515;
            --text: #FFFFFF;
            --secondary: #8E8E93;
            --tab-bg: #222222;
        }

        /* 포인트 색상 테마 */
        body.theme-orange { --primary: #FF9500; }
        body.theme-red { --primary: #FF3B30; }
        body.theme-magenta { --primary: #AF52DE; }
        body.theme-blue { --primary: #007AFF; }

        body { 
            font-family: -apple-system, sans-serif; 
            background: var(--bg); 
            color: var(--text); 
            margin: 0; padding: 20px; 
            transition: background 0.3s, color 0.3s;
            padding-top: env(safe-area-inset-top);
        }

        .container { max-width: 500px; margin: auto; position: relative; }
        
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .current-time-bar { font-size: 24px; font-weight: 700; font-variant-numeric: tabular-nums; }
        .settings-btn { font-size: 26px; cursor: pointer; background: none; border: none; color: var(--text); padding: 5px; }

        .tab-menu { display: flex; background: var(--tab-bg); border-radius: 14px; padding: 3px; margin-bottom: 15px; }
        .tab-btn { flex: 1; text-align: center; padding: 12px 0; font-size: 14px; font-weight: bold; color: var(--secondary); border-radius: 11px; cursor: pointer; border: none; background: transparent; transition: 0.2s; }
        .tab-btn.active { background: var(--card); color: var(--text); box-shadow: 0 2px 6px rgba(0,0,0,0.1); }

        .card { background: var(--card); border-radius: 24px; padding: 30px 20px; margin-bottom: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); text-align: center; }
        #countdown-label { font-size: 15px; color: var(--primary); margin-bottom: 8px; font-weight: 700; height: 1.2em; }
        #timer-text { font-size: 64px; font-weight: 800; color: var(--primary); font-variant-numeric: tabular-nums; margin: 5px 0; letter-spacing: -2px; }
        #current-task { font-size: 16px; font-weight: 600; color: var(--text); opacity: 0.9; }

        .label { font-size: 12px; font-weight: bold; color: var(--secondary); margin: 15px 0 8px 5px; display: block; }
        .radio-group { display: flex; background: var(--tab-bg); border-radius: 12px; padding: 2px; margin-bottom: 10px; }
        .radio-group label { flex: 1; text-align: center; padding: 10px 0; font-size: 13px; border-radius: 10px; cursor: pointer; color: var(--secondary); }
        .radio-group input { display: none; }
        .radio-group input:checked + label { background: var(--card); box-shadow: 0 2px 6px rgba(0,0,0,0.1); font-weight: bold; color: var(--primary); }

        .schedule-card { background: var(--card); border-radius: 18px; padding: 5px; margin-top: 10px; }
        .schedule-item { padding: 14px 18px; border-bottom: 0.5px solid var(--tab-bg); display: flex; justify-content: space-between; font-size: 13px; }
        .schedule-item:last-child { border-bottom: none; }
        .schedule-item.active-now { background: var(--tab-bg); border-radius: 14px; color: var(--primary); font-weight: bold; }

        /* 공차 계산 UI */
        .calc-input-row { display: flex; gap: 8px; margin-bottom: 10px; }
        .calc-input { flex: 1; padding: 12px; border-radius: 10px; border: 1px solid var(--tab-bg); background: var(--bg); color: var(--text); font-size: 14px; text-align: center; font-weight: 600; }
        .calc-btn-sub { padding: 0 15px; background: var(--tab-bg); color: var(--text); border: none; border-radius: 10px; font-weight: bold; cursor: pointer; }
        .calc-btn-main { padding: 0 15px; background: var(--primary); color: #fff; border: none; border-radius: 10px; font-weight: bold; cursor: pointer; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
        .calc-result-box { margin-top: 12px; padding: 15px; background: var(--bg); border-radius: 12px; font-size: 14px; color: var(--text); line-height: 1.6; font-weight: 500; text-align: center; }

        /* 설정 모달 */
        #settings-modal { 
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            background: rgba(0,0,0,0.6); z-index: 100; align-items: center; justify-content: center; backdrop-filter: blur(4px);
        }
        .modal-content { background: var(--card); width: 85%; max-width: 350px; border-radius: 28px; padding: 25px; box-shadow: 0 10px 40px rgba(0,0,0,0.4); }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; font-weight: 800; font-size: 18px; }
        .close-btn { cursor: pointer; font-size: 24px; color: var(--secondary); }
    </style>
</head>
<body class="theme-blue">

    <div class="container">
        <div class="header">
            <div class="current-time-bar" id="realtime-clock">00:00:00</div>
            <button class="settings-btn" onclick="toggleSettings(true)">⚙️</button>
        </div>

        <div class="tab-menu">
            <button class="tab-btn active" id="tab-rotation" onclick="setMode('rotation')">🔄 교대 근무</button>
            <button class="tab-btn" id="tab-general" onclick="setMode('general')">⏳ 일반 근무</button>
        </div>

        <div class="card">
            <div id="countdown-label">--</div>
            <div id="timer-text">00:00</div>
            <div id="current-task"></div>
        </div>

        <div id="position-section">
            <span class="label">포지션</span>
            <div class="radio-group">
                <input type="radio" name="pos" id="lh" value="lh" checked><label for="lh">LH</label>
                <input type="radio" name="pos" id="rest" value="rest"><label for="rest">휴식</label>
                <input type="radio" name="pos" id="rh" value="rh"><label for="rh">RH</label>
                <input type="radio" name="pos" id="glass" value="glass"><label for="glass">글라스</label>
            </div>
        </div>

        <span class="label">근무조</span>
        <div class="radio-group">
            <input type="radio" name="shift" id="day" value="day" checked><label for="day">☀️ 주간</label>
            <input type="radio" name="shift" id="night" value="night"><label for="night">🌙 야간</label>
        </div>

        <div id="general-extra" style="display: none;">
            <span class="label">차량 도착 예상 (공차 계산)</span>
            <div class="card" style="padding: 15px; margin-bottom: 0;">
                <div class="calc-input-row">
                    <input type="number" id="curr-car" class="calc-input" placeholder="현재 차번 (예: 4011)">
                    <button class="calc-btn-sub" onclick="saveCurrCar()">확인</button>
                </div>
                <div class="calc-input-row">
                    <input type="number" id="target-car" class="calc-input" placeholder="공바디 차번 (예: 4052)">
                    <button class="calc-btn-main" onclick="startCalc()">계산</button>
                </div>
                <div class="calc-result-box" id="calc-result">
                    대기중...
                </div>
            </div>
        </div>

        <span class="label">오늘의 상세 일정</span>
        <div class="schedule-card">
            <div id="schedule-list"></div>
        </div>
    </div>

    <div id="settings-modal" onclick="if(event.target == this) toggleSettings(false)">
        <div class="modal-content">
            <div class="modal-header">
                <span>환경 설정</span>
                <span class="close-btn" onclick="toggleSettings(false)">✕</span>
            </div>
            
            <span class="label">테마 모드</span>
            <div class="radio-group">
                <input type="radio" name="bg-mode" id="bg-light" value="light" checked onclick="saveAndApplyTheme()"><label for="bg-light">라이트</label>
                <input type="radio" name="bg-mode" id="bg-dark" value="dark" onclick="saveAndApplyTheme()"><label for="bg-dark">다크</label>
                <input type="radio" name="bg-mode" id="bg-oled" value="oled" onclick="saveAndApplyTheme()"><label for="bg-oled">OLED</label>
            </div>

            <span class="label">포인트 컬러</span>
            <div class="radio-group">
                <input type="radio" name="accent" id="acc-blue" value="blue" checked onclick="saveAndApplyTheme()"><label for="acc-blue">Blue</label>
                <input type="radio" name="accent" id="acc-orange" value="orange" onclick="saveAndApplyTheme()"><label for="acc-orange">Org</label>
                <input type="radio" name="accent" id="acc-red" value="red" onclick="saveAndApplyTheme()"><label for="acc-red">Red</label>
                <input type="radio" name="accent" id="acc-magenta" value="magenta" onclick="saveAndApplyTheme()"><label for="acc-magenta">Mag</label>
            </div>
        </div>
    </div>

