    function toggleSettings(show) {
        document.getElementById('settings-modal').style.display = show ? 'flex' : 'none';
    }

    function saveAndApplyTheme() {
        const bg = document.querySelector('input[name="bg-mode"]:checked').value;
        const acc = document.querySelector('input[name="accent"]:checked').value;
        localStorage.setItem('theme-bg', bg);
        localStorage.setItem('theme-acc', acc);
        
        document.body.className = '';
        if (bg === 'dark') document.body.classList.add('dark-mode');
        if (bg === 'oled') document.body.classList.add('oled-mode');
        document.body.classList.add('theme-' + acc);
    }

    function loadSavedSettings() {
        const bg = localStorage.getItem('theme-bg') || 'light';
        const acc = localStorage.getItem('theme-acc') || 'blue';
        document.getElementById('bg-' + bg).checked = true;
        document.getElementById('acc-' + acc).checked = true;
        saveAndApplyTheme();
        setMode(currentMode);

        // 공차 계산 데이터 복원
        document.getElementById('curr-car').value = localStorage.getItem(`${deviceId}_currCar`) || '';
        document.getElementById('target-car').value = localStorage.getItem(`${deviceId}_targetCar`) || '';
        if(localStorage.getItem(`${deviceId}_calcActive`) === 'true') {
            updateCalcDisplay();
        }
    }

    function setMode(mode) {
        currentMode = mode;
        localStorage.setItem('mode', mode);
        document.getElementById('tab-rotation').classList.toggle('active', mode === 'rotation');
        document.getElementById('tab-general').classList.toggle('active', mode === 'general');
        document.getElementById('position-section').style.display = mode === 'rotation' ? 'block' : 'none';
        
        // 공차 계산 UI 토글
        document.getElementById('general-extra').style.display = mode === 'general' ? 'block' : 'none';
        update();
    }

    // --- 공차 계산 로직 시작 ---
    function saveCurrCar() {
        const curr = document.getElementById('curr-car').value;
        if(curr) {
            localStorage.setItem(`${deviceId}_currCar`, curr);
            alert("현재 차번이 저장되었습니다.");
            updateCalcDisplay();
        }
    }

    function startCalc() {
        const curr = parseInt(document.getElementById('curr-car').value);
        const target = parseInt(document.getElementById('target-car').value);

        if (!curr || !target || target <= curr) {
            alert("차번을 올바르게 입력해주세요. (공바디 번호가 더 커야 합니다)");
            localStorage.setItem(`${deviceId}_calcActive`, 'false');
            return;
        }
        
        localStorage.setItem(`${deviceId}_currCar`, curr);
        localStorage.setItem(`${deviceId}_targetCar`, target);
        localStorage.setItem(`${deviceId}_calcActive`, 'true');
        updateCalcDisplay();
    }

    function updateCalcDisplay() {
        if (localStorage.getItem(`${deviceId}_calcActive`) !== 'true') {
            document.getElementById('calc-result').innerHTML = "차번을 입력하고 계산을 눌러주세요.";
            return;
        }
        
        const curr = parseInt(localStorage.getItem(`${deviceId}_currCar`));
        const target = parseInt(localStorage.getItem(`${deviceId}_targetCar`));
        if (!curr || !target) return;

        const diff = target - curr;
        const minsPerCar = 10 / 6.5; // 차량 1대당 소요 시간 (약 1.538분)
        let remainingWorkMins = diff * minsPerCar;

        let now = new Date();
        let simulatedMins = now.getHours() * 60 + now.getMinutes();
        let startMins = simulatedMins;

        // 휴게 시간 스킵 로직 적용
        while (remainingWorkMins > 0) {
            let inBreak = false;
            // 점심 정지 시간: 11:00 (660분) ~ 11:40 (700분)
            if (simulatedMins >= 660 && simulatedMins < 700) {
                simulatedMins = 700;
                inBreak = true;
            }
            // 저녁 정지 시간: 19:50 (1190분) ~ 20:30 (1230분)
            else if (simulatedMins >= 1190 && simulatedMins < 1230) {
                simulatedMins = 1230;
                inBreak = true;
            }

            if (!inBreak) {
                simulatedMins++;
                remainingWorkMins--;
            }
        }

        const realRemainingMins = Math.round(simulatedMins - startMins);
        let finalDate = new Date(now.getTime() + realRemainingMins * 60000);
        let fh = String(finalDate.getHours()).padStart(2, '0');
        let fm = String(finalDate.getMinutes()).padStart(2, '0');

        document.getElementById('calc-result').innerHTML = 
            `현재 차번은 <b>${curr}</b> 이며 <b>${target}</b> 까지는 <b>${realRemainingMins}</b>분이 남았습니다.<br>
            <span style="color:var(--primary); font-size:16px; margin-top:5px; display:inline-block; font-weight:800;">공바디 도착 예상시간은 ${fh}:${fm} 분입니다.</span>`;
    }
    // --- 공차 계산 로직 종료 ---

    function update() {
        const now = new Date();
        const clockStr = now.getHours().toString().padStart(2,'0') + ":" + now.getMinutes().toString().padStart(2,'0') + ":" + now.getSeconds().toString().padStart(2,'0');
        document.getElementById('realtime-clock').innerText = clockStr;
        const nowMin = now.getHours() * 60 + now.getMinutes();
        const nowSec = now.getSeconds();
        const isNight = document.querySelector('input[name="shift"]:checked').checked && document.querySelector('input[name="shift"]:checked').value === "night";
        const shiftVal = document.querySelector('input[name="shift"]:checked').value;
        let targetData = currentMode === 'general' ? RAW_DATA.general : RAW_DATA[document.querySelector('input[name="pos"]:checked').value];
        const currentSchedule = targetData.filter(item => shiftVal === "night" ? item.n : !item.n);

        let checkMin = nowMin;
        if (shiftVal === "night" && nowMin < 360) checkMin += 1440;
        currentSchedule.forEach(item => {
            let [sh, sm] = item.s.split(':').map(Number);
            let [eh, em] = item.e.split(':').map(Number);
            let start = sh * 60 + sm;
            let end = eh * 60 + em;
            if (shiftVal === "night" && start < 360) start += 1440;
            if (shiftVal === "night" && end < 360) end += 1440;
            if (end < start) end += 1440;
            item._start = start; item._end = end;
        });
        const label = document.getElementById('countdown-label');
        const timer = document.getElementById('timer-text');
        const task = document.getElementById('current-task');

        const firstShift = currentSchedule[0];
        const lastShift = currentSchedule[currentSchedule.length - 1];
        
        if (checkMin < firstShift._start || checkMin >= lastShift._end) {
            timer.innerText = "--:--";
            label.innerText = "OFF"; 
            task.innerText = "퇴근입니다. 오늘 하루도 고생 많으셨습니다."; // 요청하신 퇴근 문구 변경 반영
            renderList(currentSchedule, null); return;
        }

        let currentShift = currentSchedule.find(i => checkMin >= i._start && checkMin < i._end);
        let nextIdx = currentSchedule.findIndex(i => checkMin >= i._start && checkMin < i._end) + 1;
        let nextShift = currentSchedule[nextIdx];
        if (currentShift) {
            let diffSec = (currentShift._end * 60) - (checkMin * 60 + nowSec);
            timer.innerText = `${String(Math.floor(diffSec / 60)).padStart(2, '0')}:${String(diffSec % 60).padStart(2, '0')}`;
            
            if (currentMode === 'general') {
                if (currentShift.p.includes("점심") || currentShift.p.includes("저녁") || currentShift.p.includes("휴식")) {
                    label.innerText = "다음 근무 시작까지";
                    task.innerText = `${currentShift.p} 시간 (${currentShift.s}~${currentShift.e})`;
                } else {
                    if (diffSec <= 600 && nextShift) {
                        if (nextShift.p.includes("점심") || nextShift.p.includes("저녁")) label.innerText = "곧 식사 시간입니다";
                        else if (nextShift.p.includes("휴식")) label.innerText = "곧 쉬는 시간입니다";
                        else label.innerText = "다음 근무 시작까지";
                    } else {
                        label.innerText = "다음 근무 시작까지";
                    }
                    task.innerText = `현재: ${currentShift.p} (${currentShift.s}~${currentShift.e})`;
                }
            } else {
                label.innerText = "남은 교대까지";
                task.innerText = `현재: ${currentShift.p} (${currentShift.s}~${currentShift.e})`;
            }
        }
        renderList(currentSchedule, currentShift);
        
        // 실시간(1분 단위 연동) 공차 계산 업데이트
        if(currentMode === 'general') {
            updateCalcDisplay();
        }
    }

    function renderList(list, currentShift) {
        const listDiv = document.getElementById('schedule-list');
        listDiv.innerHTML = list.map(item => `
            <div class="schedule-item ${currentShift && item.s === currentShift.s ? 'active-now' : ''}">
                <span>${item.s} ~ ${item.e}</span>
                <span>${item.p}</span>
            </div>
        `).join('');
    }

    document.querySelectorAll('input').forEach(input => input.addEventListener('change', update));
    window.onload = loadSavedSettings;
    setInterval(update, 1000);
</script>
